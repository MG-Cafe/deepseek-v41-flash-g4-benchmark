@@ -0,0 +1,265 @@
+"""Sequence-sharded mHC residual for DSV4.1 eager PREFILL (tp only).
+
+With ``SGLANG_DSV41_PREFILL_SHARD_MHC`` set, an extend forward with at least
+``SGLANG_DSV41_PREFILL_SHARD_MHC_MIN_TOKENS`` tokens keeps the mHC residual
+``[T, hc, H]`` split over tokens across the TP ranks for every layer:
+
+  * both per-sublayer prefill collectives (attention ``wo_b`` and the MoE
+    combine, see fp8_prefill_ar) become an fp8 REDUCE-SCATTER over tokens
+    (same common per-token scale as the fp8 all-reduce, T padded to a multiple
+    of the world size),
+  * hc_post / mix-stats / combine+norm run on the local T/world rows only,
+  * only the next sublayer's input ``[T, H]`` is all-gathered:
+      - attention input: bf16 (mode 2, exact) or per-token-scaled e4m3 (mode 1),
+      - MoE input: MXFP8 (``..._MOE=mx``, default; the routed experts re-quantize
+        it to the same bytes, router/shared experts see the MXFP8 value) or
+        bf16 (``..._MOE=bf16``, exact).
+
+Decode, target-verify and CUDA graphs never shard (eager extend only). Off by
+default; with the env unset nothing here runs.
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+from typing import Optional
+
+import torch
+import torch.distributed as dist
+import triton
+import triton.language as tl
+
+MODE: int = int(os.environ.get("SGLANG_DSV41_PREFILL_SHARD_MHC", "0") or 0)
+MIN_TOKENS: int = int(os.environ.get("SGLANG_DSV41_PREFILL_SHARD_MHC_MIN_TOKENS", "2048"))
+MOE_GATHER: str = os.environ.get("SGLANG_DSV41_PREFILL_SHARD_MHC_MOE", "mx")
+DEBUG: bool = os.environ.get("SGLANG_DSV41_PREFILL_SHARD_MHC_DEBUG", "0") == "1"
+#: A/B aid: if set, the file's content ("0", "1", "2") overrides MODE, re-read
+#: once per extend forward (toggle it only while the server is idle).
+TOGGLE_FILE: str = os.environ.get("SGLANG_DSV41_PREFILL_SHARD_MHC_TOGGLE_FILE", "")
+RUN_MODE: int = MODE
+RUN_MOE: str = MOE_GATHER
+#: Debug only (toggle-file mode 3): exact prod collective (fp8 all-reduce, keep
+#: local rows) + bf16 attention gather, to check the sharding plumbing bitwise.
+RUN_AR_SLICE: bool = False
+
+
+def current_mode() -> int:
+    """Toggle-file syntax: "<mode>[:<moe gather>]", e.g. "2", "1:mx", "3:bf16"."""
+    global RUN_MODE, RUN_MOE, RUN_AR_SLICE
+    RUN_MODE, RUN_MOE = MODE, MOE_GATHER
+    if TOGGLE_FILE:
+        try:
+            with open(TOGGLE_FILE) as f:
+                parts = f.read().strip().split(":")
+            RUN_MODE = int(parts[0] or 0)
+            if len(parts) > 1 and parts[1]:
+                RUN_MOE = parts[1]
+        except (OSError, ValueError):
+            RUN_MODE = 0
+    RUN_AR_SLICE = RUN_MODE == 3
+    return RUN_MODE
+
+_BLOCK = 1024
+
+
+@dataclass
+class ShardCtx:
+    group: object
+    world: int
+    rank: int
+    T: int
+    T_pad: int
+    TL: int
+
+    @property
+    def start(self) -> int:
+        return self.rank * self.TL
+
+
+#: Set while the sharded layer loop runs; the fp8 prefill AR sites turn into
+#: reduce-scatters only while it is set and the tensor has exactly T rows.
+ACTIVE: Optional[ShardCtx] = None
+#: Set when the layer loop returned sharded hidden states; consumed by the model.
+OUTPUT: Optional[ShardCtx] = None
+CALLS: int = 0
+
+
+def make_ctx(num_tokens: int, group) -> ShardCtx:
+    world = dist.get_world_size(group=group)
+    rank = dist.get_rank(group=group)
+    t_pad = -(-num_tokens // world) * world
+    return ShardCtx(group, world, rank, num_tokens, t_pad, t_pad // world)
+
+
+def shard_rows(x: torch.Tensor, ctx: ShardCtx) -> torch.Tensor:
+    """This rank's rows of a full [T, ...] tensor, zero-padded to TL rows."""
+    lo = ctx.start
+    hi = min(lo + ctx.TL, ctx.T)
+    if hi - lo == ctx.TL:
+        return x[lo:hi].contiguous()
+    out = x.new_zeros((ctx.TL, *x.shape[1:]))
+    if hi > lo:
+        out[: hi - lo].copy_(x[lo:hi])
+    return out
+
+
+# --- kernels -----------------------------------------------------------------
+
+
+@triton.jit
+def _row_amax_kernel(X, S, H, stride_x, BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    acc = tl.zeros([BLOCK], tl.float32)
+    for off in range(0, H, BLOCK):
+        idx = off + tl.arange(0, BLOCK)
+        x = tl.load(X + row * stride_x + idx, mask=idx < H, other=0.0).to(tl.float32)
+        acc = tl.maximum(acc, tl.abs(x))
+    tl.store(S + row, tl.max(acc, axis=0))
+
+
+@triton.jit
+def _quant_kernel(X, S, Q, H, stride_x, stride_q, HEADROOM, BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    scale = tl.load(S + row) * HEADROOM / 448.0
+    scale = tl.where(scale > 0.0, scale, 1.0)
+    inv = 1.0 / scale
+    for off in range(0, H, BLOCK):
+        idx = off + tl.arange(0, BLOCK)
+        m = idx < H
+        x = tl.load(X + row * stride_x + idx, mask=m, other=0.0).to(tl.float32)
+        q = tl.minimum(tl.maximum(x * inv, -448.0), 448.0)
+        tl.store(Q + row * stride_q + idx, q.to(tl.float8e4nv), mask=m)
+
+
+@triton.jit
+def _dequant_kernel(Q, S, Y, H, stride_q, stride_y, HEADROOM, BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    scale = tl.load(S + row) * HEADROOM / 448.0
+    scale = tl.where(scale > 0.0, scale, 1.0)
+    for off in range(0, H, BLOCK):
+        idx = off + tl.arange(0, BLOCK)
+        m = idx < H
+        q = tl.load(Q + row * stride_q + idx, mask=m, other=0.0).to(tl.float32)
+        tl.store(Y + row * stride_y + idx, (q * scale).to(tl.bfloat16), mask=m)
+
+
+@triton.jit
+def _mx_dequant_kernel(Q, SF, Y, H, BLOCK: tl.constexpr):
+    """[R, H] e4m3 with per-32 ue8m0 scales [R, H/32] -> bf16 (exact)."""
+    row = tl.program_id(0)
+    for off in range(0, H, BLOCK):
+        idx = off + tl.arange(0, BLOCK)
+        m = idx < H
+        q = tl.load(Q + row * H + idx, mask=m, other=0.0).to(tl.float32)
+        e = tl.load(SF + row * (H // 32) + idx // 32, mask=m, other=127).to(tl.float32)
+        tl.store(Y + row * H + idx, (q * tl.exp2(e - 127.0)).to(tl.bfloat16), mask=m)
+
+
+# --- collectives -------------------------------------------------------------
+
+
+def fp8_reduce_scatter(x: torch.Tensor, ctx: ShardCtx) -> torch.Tensor:
+    """Sum [T, H] bf16 partials over the group with an e4m3 wire (common
+    per-token scale, headroom = world) and return this rank's [TL, H] rows."""
+    global CALLS
+    CALLS += 1
+    T, H = x.shape
+    assert T == ctx.T and x.is_contiguous()
+    amax = torch.empty(ctx.T_pad, dtype=torch.float32, device=x.device)
+    if ctx.T_pad > T:
+        amax[T:].zero_()
+    _row_amax_kernel[(T,)](x, amax, H, x.stride(0), BLOCK=_BLOCK, num_warps=8)
+    dist.all_reduce(amax, op=dist.ReduceOp.MAX, group=ctx.group)
+    q = torch.empty((ctx.T_pad, H), dtype=torch.float8_e4m3fn, device=x.device)
+    if ctx.T_pad > T:
+        q[T:].view(torch.uint8).zero_()
+    headroom = float(ctx.world)
+    _quant_kernel[(T,)](
+        x, amax, q, H, x.stride(0), q.stride(0), headroom, BLOCK=_BLOCK, num_warps=8
+    )
+    out_q = torch.empty((ctx.TL, H), dtype=torch.float8_e4m3fn, device=x.device)
+    dist.reduce_scatter_tensor(out_q, q, op=dist.ReduceOp.SUM, group=ctx.group)
+    y = torch.empty((ctx.TL, H), dtype=torch.bfloat16, device=x.device)
+    local_amax = amax[ctx.start : ctx.start + ctx.TL]
+    _dequant_kernel[(ctx.TL,)](
+        out_q, local_amax, y, H, out_q.stride(0), y.stride(0), headroom,
+        BLOCK=_BLOCK, num_warps=8,
+    )
+    if DEBUG and CALLS <= 4:
+        print(f"[prefill_shard_mhc] RS call={CALLS} T={T} TL={ctx.TL}", flush=True)
+    return y
+
+
+def all_gather_bf16(y: torch.Tensor, ctx: ShardCtx) -> torch.Tensor:
+    out = torch.empty((ctx.T_pad, *y.shape[1:]), dtype=y.dtype, device=y.device)
+    dist.all_gather_into_tensor(out, y.contiguous(), group=ctx.group)
+    return out[: ctx.T]
+
+
+def all_gather_fp8(y: torch.Tensor, ctx: ShardCtx) -> torch.Tensor:
+    """Per-token-scaled e4m3 all-gather of [TL, H] bf16 -> [T, H] bf16."""
+    TL, H = y.shape
+    amax = torch.empty(TL, dtype=torch.float32, device=y.device)
+    _row_amax_kernel[(TL,)](y, amax, H, y.stride(0), BLOCK=_BLOCK, num_warps=8)
+    q = torch.empty((TL, H), dtype=torch.float8_e4m3fn, device=y.device)
+    _quant_kernel[(TL,)](y, amax, q, H, y.stride(0), q.stride(0), 1.0, BLOCK=_BLOCK, num_warps=8)
+    q_all = torch.empty((ctx.T_pad, H), dtype=q.dtype, device=y.device)
+    a_all = torch.empty(ctx.T_pad, dtype=torch.float32, device=y.device)
+    dist.all_gather_into_tensor(q_all, q, group=ctx.group)
+    dist.all_gather_into_tensor(a_all, amax, group=ctx.group)
+    out = torch.empty((ctx.T, H), dtype=torch.bfloat16, device=y.device)
+    _dequant_kernel[(ctx.T,)](
+        q_all, a_all, out, H, q_all.stride(0), out.stride(0), 1.0, BLOCK=_BLOCK, num_warps=8
+    )
+    return out
+
+
+def mx_quantize(y: torch.Tensor):
+    from flashinfer import mxfp8_quantize
+
+    q, sf = mxfp8_quantize(y, is_sf_swizzled_layout=False, alignment=32)
+    return q, sf.view(torch.uint8).reshape(y.shape[0], y.shape[1] // 32)
+
+
+def mx_dequantize(q: torch.Tensor, sf: torch.Tensor, rows: int) -> torch.Tensor:
+    H = q.shape[1]
+    out = torch.empty((rows, H), dtype=torch.bfloat16, device=q.device)
+    _mx_dequant_kernel[(rows,)](q, sf, out, H, BLOCK=_BLOCK, num_warps=8)
+    return out
+
+
+def all_gather_mx(y: torch.Tensor, ctx: ShardCtx) -> torch.Tensor:
+    """MXFP8 all-gather of [TL, H] bf16 -> [T, H] bf16 holding the exact MXFP8
+    values, so flashinfer's routed-input mxfp8_quantize reproduces its bytes."""
+    TL, H = y.shape
+    q, sf = mx_quantize(y)
+    q_all = torch.empty((ctx.T_pad, H), dtype=q.dtype, device=y.device)
+    s_all = torch.empty((ctx.T_pad, H // 32), dtype=torch.uint8, device=y.device)
+    dist.all_gather_into_tensor(q_all, q.contiguous(), group=ctx.group)
+    dist.all_gather_into_tensor(s_all, sf.contiguous(), group=ctx.group)
+    return mx_dequantize(q_all, s_all, ctx.T)
+
+
+def gather_attn_input(y: torch.Tensor, ctx: ShardCtx) -> torch.Tensor:
+    return all_gather_fp8(y, ctx) if RUN_MODE == 1 else all_gather_bf16(y, ctx)
+
+
+def gather_moe_input(y: torch.Tensor, ctx: ShardCtx) -> torch.Tensor:
+    if RUN_MOE == "mx":
+        return all_gather_mx(y, ctx)
+    if RUN_MOE == "fp8":
+        return all_gather_fp8(y, ctx)
+    return all_gather_bf16(y, ctx)
+
+
+def maybe_reduce_scatter(x: torch.Tensor) -> Optional[torch.Tensor]:
+    """Called by both fp8 prefill AR sites: the RS result while sharding, else None."""
+    ctx = ACTIVE
+    if ctx is None or x.dim() != 2 or x.shape[0] != ctx.T:
+        return None
+    if RUN_AR_SLICE:
+        from sglang.srt.distributed.fp8_prefill_ar import fp8_all_reduce
+
+        return shard_rows(fp8_all_reduce(x.contiguous(), group=ctx.group), ctx)
+    return fp8_reduce_scatter(x.contiguous(), ctx)

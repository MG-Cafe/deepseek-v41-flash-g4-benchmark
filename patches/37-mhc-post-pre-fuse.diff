# Patch: 37-mhc-post-pre-fuse.diff
--- a/python/sglang/kernels/ops/layernorm/mhc_post_combine.py	1970-01-01 00:00:00.000000000 +0000
+++ b/python/sglang/kernels/ops/layernorm/mhc_post_combine.py	2026-09-23 00:29:26.228834770 +0000
@@ -0,0 +1,90 @@
+"""Fused HC=4 mHC post-mix + next-sublayer combine.
+
+One pass computes, per token t and hidden index h,
+
+    new[t, o, h] = bf16(post[t, o] * x[t, h] + sum_i comb[t, i, o] * res[t, i, h])
+    y[t, h]      = bf16(sum_o pre[t, o] * new[t, o, h])
+
+i.e. ``mhc_post`` followed by ``hc_combine(new, pre)`` (the pre-norm input of
+the next sublayer), without re-reading ``new`` from DRAM. The arithmetic
+mirrors ``_mhc_post_split_h_kernel`` (itself bit-matched to
+``mhc_post_tilelang``) and ``_hc_combine_kernel`` operation for operation, so
+both outputs are bit-identical to the unfused path.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _mhc_post_combine_kernel(
+    X,
+    R,
+    P,
+    C,
+    PRE,
+    Y,
+    OUT,
+    pre_stride_m,
+    pre_stride_k,
+    out_stride_m,
+    H: tl.constexpr,
+    B: tl.constexpr,
+):
+    token = tl.program_id(0).to(tl.int64)
+    h = tl.program_id(1) * B + tl.arange(0, B)
+    mask = h < H
+    x = tl.load(X + token * H + h, mask, 0).to(tl.float32)
+    r0 = tl.load(R + token * 4 * H + h, mask, 0).to(tl.float32)
+    r1 = tl.load(R + (token * 4 + 1) * H + h, mask, 0).to(tl.float32)
+    r2 = tl.load(R + (token * 4 + 2) * H + h, mask, 0).to(tl.float32)
+    r3 = tl.load(R + (token * 4 + 3) * H + h, mask, 0).to(tl.float32)
+    y = tl.zeros([B], dtype=tl.float32)
+    for o in tl.static_range(4):
+        p = tl.load(P + token * 4 + o)
+        c0 = tl.load(C + token * 16 + o)
+        c1 = tl.load(C + token * 16 + 4 + o)
+        c2 = tl.load(C + token * 16 + 8 + o)
+        c3 = tl.load(C + token * 16 + 12 + o)
+        # Same contraction order as _mhc_post_split_h_kernel.
+        acc = tl.fma(p, x, c0 * r0)
+        acc = tl.fma(c1, r1, acc)
+        acc = tl.fma(c2, r2, acc)
+        acc = tl.fma(c3, r3, acc)
+        acc_bf16 = acc.to(tl.bfloat16)
+        tl.store(Y + (token * 4 + o) * H + h, acc_bf16, mask)
+        # _hc_combine_kernel: acc += pre_k * x_k, contracted to an FMA.
+        pk = tl.load(PRE + token * pre_stride_m + o * pre_stride_k).to(tl.float32)
+        y = tl.fma(pk, acc_bf16.to(tl.float32), y)
+    tl.store(OUT + token * out_stride_m + h, y.to(tl.bfloat16), mask)
+
+
+def mhc_post_combine(x, residual, post, comb, pre):
+    """Returns (new_residual [T,4,H] bf16, combined [T,H] bf16)."""
+    assert x.dtype == residual.dtype == torch.bfloat16
+    assert post.dtype == comb.dtype == torch.float32
+    assert residual.shape == (x.shape[0], 4, x.shape[1])
+    assert pre.shape[0] == x.shape[0] and pre.shape[-1] == 4
+    assert all(t.is_contiguous() for t in (x, residual, post, comb))
+    pre2 = pre.reshape(pre.shape[0], 4)
+    new = torch.empty_like(residual)
+    out = torch.empty_like(x)
+    block = 1024
+    _mhc_post_combine_kernel[(x.shape[0], triton.cdiv(x.shape[1], block))](
+        x,
+        residual,
+        post,
+        comb,
+        pre2,
+        new,
+        out,
+        pre2.stride(0),
+        pre2.stride(1),
+        out.stride(0),
+        H=x.shape[1],
+        B=block,
+        num_warps=4,
+        enable_fp_fusion=False,
+    )
+    return new, out

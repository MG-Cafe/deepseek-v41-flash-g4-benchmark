 _HC_MIX_BLOCK_M_MID = 16
 _HC_MIX_MID_MAX_M = 2048
 
+# PATCH 26 -- OPT-IN pre-transposed-w gather + launch-order swizzle for the
+# mix-stats partial kernel.  DEFAULT OFF.  Unset, _mix_grid and
+# _hc_mix_w_operand are identities and FAST=False, so the emitted kernel and the
+# launch are byte-for-byte the shipped ones.  The gate is not optional: the A/B
+# rig arms ONE replica and leaves its sibling as the contemporaneous control, so
+# the same binary must serve both arms.
+#
+# ARITHMETIC-NEUTRAL.  Measured torch.equal == True against the shipped kernel
+# (rel-Fro 0.000e+00), MISMATCH_M = [] over 37 M values 1..8193 crossing all
+# three _block_m_for regimes, repeat launches bit-identical x3.  Bit-identity
+# matters here because the model uses discrete MoE gating and two EP ranks
+# computing different bits could dispatch to different experts; this patch
+# changes no arithmetic, no reduction order and no dot precision.
+#
+# MECHANISM (SASS-verified, ncu counters being blocked in-pod): the shipped
+# strided w load costs registers, and this kernel is register-capped.  The
+# pre-transposed operand drops it from 166 -> 120 regs at DOT_PRECISION=tf32,
+# i.e. 3 -> 4 concurrent blocks/SM on a latency-bound kernel.  See
+# patches/ported/26-mhc-mix-stats-gather-pretrans-swizzle.PINNED.diff.
+#
+# PORT NOTE (pinned image, sep21 campaign): the original patch gated this with
+# `os.environ.get(...)` and added `import os`.  This file does NOT import os and
+# DOES already import `envs` (top of module), so the port uses the tree's own
+# EnvBool convention instead -- which also lets this patch stack on patch 22
+# (two `import os` insertions at the top of one file cannot both apply).
+# `.get()` is mandatory -- EnvField.__bool__ raises by design.
+_HC_MIX_FAST_GATHER = envs.SGLANG_DSV41_MHC_GATHER.get()
+if _HC_MIX_FAST_GATHER:
+    logger.info(
+        "mHC mix-stats: patch 26 pre-transposed-w gather + launch swizzle ENABLED"
+    )
+
+_HC_MIX_WT_CACHE = {}
+_HC_MIX_WT_LOCK = threading.Lock()
+
+
+def _mix_grid(grid_m: int, num_slices: int):
+    """Grid tuple matching the program_id order the partial kernel will use."""
+    return (num_slices, grid_m) if _HC_MIX_FAST_GATHER else (grid_m, num_slices)
+
+
+def _hc_mix_w_operand(hc_fn: torch.Tensor, mix_pad: int) -> torch.Tensor:
+    """hc_fn unchanged, or its cached zero-padded [K, mix_pad] fp32 transpose.
+
+    hc_fn is a model weight, so the transpose is built once per weight and
+    reused.  The cache entry holds a reference to hc_fn itself, so its storage
+    cannot be freed and its data_ptr cannot be recycled under a stale entry.
+    Costs mix_pad * K * 4 B per distinct weight (2.62 MB at MIX_PAD=32,
+    K=20480) and one ~4.5 us transpose, both one-time.
+    """
+    if not _HC_MIX_FAST_GATHER:
+        return hc_fn
+    key = (hc_fn.data_ptr(), tuple(hc_fn.shape), mix_pad, str(hc_fn.device))
+    ent = _HC_MIX_WT_CACHE.get(key)
+    if ent is None:
+        with _HC_MIX_WT_LOCK:
+            ent = _HC_MIX_WT_CACHE.get(key)
+            if ent is None:
+                mix, k = hc_fn.shape
+                wt = torch.zeros(
+                    (k, mix_pad), dtype=torch.float32, device=hc_fn.device
+                )
+                wt[:, :mix] = hc_fn.t()
+                ent = (hc_fn, wt.contiguous())
+                _HC_MIX_WT_CACHE[key] = ent
+    return ent[1]
+
 
 def _block_m_for(m: int) -> int:
     """Row-tile choices preserve each row's arithmetic and may depend on M."""

{
  "deployedModel": {
    "displayName": "deepseek-v41-flash-g4_192_tp4",
    "serviceAccount": "vertex-model-serving@<YOUR_PROJECT_ID>.iam.gserviceaccount.com",
    "dedicatedResources": {
      "machineSpec": {
        "machineType": "g4-standard-192",
        "acceleratorType": "NVIDIA_RTX_PRO_6000",
        "acceleratorCount": 4
      },
      "minReplicaCount": 2,
      "maxReplicaCount": 2,
      "diskSpec": {
        "bootDiskType": "hyperdisk-balanced",
        "bootDiskSizeGb": 1000
      }
    }
  },
  "model": {
    "displayName": "deepseek-v41-flash-g4_192_tp4",
    "containerSpec": {
      "imageUri": "us-docker.pkg.dev/agent-platform-mg-public/containers/sglang-airlock:ds41-e56358a-rev1",
      "args": [
        "sglang",
        "serve",
        "--model-path=/models/deepseek-ai/DeepSeek-V4.1-Flash",
        "--trust-remote-code",
        "--tp-size=4",
        "--ep-size=4",
        "--context-length=1048576",
        "--moe-runner-backend=flashinfer_mxfp4",
        "--fp8-gemm-backend=flashinfer_cutlass",
        "--enable-deepseek-v4-fp4-indexer",
        "--mem-fraction-static=0.856",
        "--swa-full-tokens-ratio=0.035",
        "--chunked-prefill-size=8192",
        "--max-running-requests=64",
        "--cuda-graph-max-bs-decode=64",
        "--min-free-slots-delay=1",
        "--speculative-algorithm=DSPARK",
        "--enable-hierarchical-cache",
        "--hicache-ratio=2",
        "--enable-metrics",
        "--enable-cache-report",
        "--reasoning-parser=deepseek-v41",
        "--tool-call-parser=deepseekv41",
        "--dist-timeout=1200",
        "--nnodes=1",
        "--node-rank=0",
        "--host=0.0.0.0",
        "--base-gpu-id=0",
        "--port=7080",
        "--dist-init-addr=127.0.0.1:20010"
      ],
      "env": [
        {
          "name": "MODEL_ID",
          "value": "deepseek-ai/DeepSeek-V4.1-Flash"
        },
        {
          "name": "SGLANG_TOOL_STRICT_LEVEL",
          "value": "2"
        },
        {
          "name": "SGLANG_SM120_FLASHMLA_BACKEND",
          "value": "triton"
        },
        {
          "name": "NCCL_P2P_LEVEL",
          "value": "SYS"
        },
        {
          "name": "SGLANG_ENABLE_DSV41_ENGRAM_HOST_TABLE",
          "value": "1"
        },
        {
          "name": "SGLANG_DSV41_ENGRAM_HOST_TABLE_LAYOUT",
          "value": "private"
        },
        {
          "name": "SGLANG_CUSTOM_AR_ALLOW_PCIE_P2P",
          "value": "1"
        },
        {
          "name": "SGLANG_DENSE_NVFP4",
          "value": "1"
        },
        {
          "name": "SGLANG_DENSE_NVFP4_LAYERS",
          "value": "."
        },
        {
          "name": "SGLANG_WO_A_FP8_REQUANT",
          "value": "1"
        },
        {
          "name": "SGLANG_FP8_PREFILL_AR",
          "value": "1"
        },
        {
          "name": "SGLANG_FP8_PREFILL_AR2",
          "value": "1"
        },
        {
          "name": "SGLANG_DSV41_FUSE_MERGE_SINK",
          "value": "1"
        },
        {
          "name": "SPARSE_MLA_DECODE_DSV4P1_G4",
          "value": "1"
        },
        {
          "name": "DECODE_HEAD_TRIM_DSV4P1_G4",
          "value": "1"
        },
        {
          "name": "SGLANG_DSV41_MHC_MIX_TF32",
          "value": "1"
        },
        {
          "name": "SGLANG_DSV41_MHC_GATHER",
          "value": "1"
        },
        {
          "name": "SGLANG_DSV41_INDEXER_CHUNK_MB",
          "value": "128"
        },
        {
          "name": "SGLANG_DSV41_SPARSE_PREFILL_QTILE",
          "value": "2"
        },
        {
          "name": "SGLANG_DSV41_MHC_FUSE_POST_PRE_TRITON",
          "value": "1"
        },
        {
          "name": "SGLANG_DSV41_SPARSE_DECODE_SPLITK",
          "value": "1"
        },
        {
          "name": "SGLANG_DSV41_PREFILL_SHARD_MHC",
          "value": "1"
        },
        {
          "name": "SGLANG_DSV41_PREFILL_ATTN_ROWSHARD",
          "value": "1"
        },
        {
          "name": "SGLANG_DSV41_SPARSE_PREFILL_H64",
          "value": "1"
        },
        {
          "name": "SGLANG_DSV41_FP4_GEMM_DIRECT",
          "value": "1"
        },
        {
          "name": "SGLANG_DSV41_INDEXER_MASK_INCR",
          "value": "1"
        },
        {
          "name": "SGLANG_FLASHINFER_AUTOTUNE_CACHE",
          "value": "0"
        }
      ],
      "ports": [
        {
          "containerPort": 7080
        }
      ],
      "healthRoute": "/health_generate",
      "predictRoute": "/v1/chat/completions",
      "sharedMemorySizeMb": "40960",
      "deploymentTimeout": "7200s"
    }
  }
}